#!ts
/**
 * renditions-scan — announce every file whose renditions are not those the rendition table names now.
 *
 * `generate-derivatives` marks a file once it has every rendition the table owes it
 * (`@media/rendition-marker`): `renditionsFor`, the signature of the table's entries for the
 * file's kind. This finds the files whose marker is missing or names another signature, by one
 * query per kind rather than a walk, in every tree under the path (`/` unless one is given), and
 * announces `media.renditions.stale` for each, which only the rendition pipelines take: they make
 * what is missing and mark the file. A changed table changes the signature of the kinds it
 * changed, so the next scan reopens those files and no others. A file with a rendition refused
 * under a CPU budget EMS no longer runs is announced too, so the refused rendition is tried again.
 *
 * What it passes over is `@media/stale-scan`'s, and a folder that does not want renditions
 * (`processing`).
 *
 * `--if-idle` announces nothing while the rendition pipelines have work waiting, which is how the
 * `renditions-heal` service runs it; `--limit` caps the facts of one run, and 0 lifts the cap.
 */

import type { RenditionKind } from '@ein/api';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, readRenditionTable, reportUnknownFlags } from '@ein/client';
import { resolve } from '@std/path';
import { generations } from '@ems/client';
import type { RenditionsScanAnswer } from '@media/api';
import { RENDITION_FACTS } from '@media/facts';
import { refusalsOf, RENDITIONS_FOR_ATTR, renditionSignature, TRANSCODE_REFUSED_ATTR } from '@media/rendition-marker';
import { scanStale, type StaleQuery } from '@media/stale-scan';
import { allWait, factsWaiting } from '@media/waiting';

/** The mimetypes of each kind of the table. */
const PREFIXES: Record<RenditionKind, string> = { photo: 'image/', video: 'video/', audio: 'audio/' };

/** Facts one run announces at most, unless `--limit` says otherwise. */
const DEFAULT_LIMIT = 1000;

const renditionsScan = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    string: ['limit'],
    boolean: ['if-idle', 'dry-run', 'verbose'],
    alias: { n: 'dry-run', v: 'verbose' },
    unknown: collectUnknownFlags(unknown),
  });

  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const limitFlag = Number(flags.limit);
  const limit = flags.limit === undefined || !Number.isFinite(limitFlag) || limitFlag < 0 ? DEFAULT_LIMIT : limitFlag;
  const dry = Boolean(flags['dry-run']);
  const verbose = Boolean(flags.verbose);
  const root = flags._.length > 0 ? resolve(cmd.cwd, String(flags._[0])) : '/';

  const answer = async (result: RenditionsScanAnswer, text: string): CmdReturn => {
    if (cmd.json) await cmd.writeJSON(result satisfies RenditionsScanAnswer);
    else await cmd.writeLn(`renditions-scan: ${text}`);
    return 0;
  };

  if (flags['if-idle'] && allWait(await factsWaiting(cmd, 'renditions-scan'), [RENDITION_FACTS.stale])) {
    return await answer(
      { examined: 0, announced: 0, waiting: true, limited: false, unchecked: [] },
      'rendition work is waiting, nothing announced',
    );
  }

  let table;
  try {
    table = (await readRenditionTable(cmd.sys.vfs)).table;
  } catch (error) {
    await cmd.writeError(`renditions-scan: failed to read /etc/renditions.yaml: ${(error as Error).message}\n`);
    return 1;
  }

  // The CPU budget EMS runs under, which a refusal is trusted under only while it is the same.
  const budget = (await generations(cmd))?.cpuBudget ?? undefined;
  const unchecked = budget === undefined ? ['refusals'] : [];

  const signatures = new Map<RenditionKind, string>();
  for (const kind of Object.keys(PREFIXES) as RenditionKind[]) signatures.set(kind, await renditionSignature(table, kind));
  const kindOf = (attrs: Record<string, unknown>) => (Object.keys(PREFIXES) as RenditionKind[]).find((kind) => String(attrs.mimetype ?? '').startsWith(PREFIXES[kind]));
  const marked = (attrs: Record<string, unknown>) => typeof attrs[RENDITIONS_FOR_ATTR] === 'string' ? attrs[RENDITIONS_FOR_ATTR] as string : '';

  const queries: StaleQuery[] = [...signatures].map(([kind, signature]) => ({
    where: [{ ref: 'mimetype', op: 'prefix', value: PREFIXES[kind] }, { ref: RENDITIONS_FOR_ATTR, op: 'ne', value: signature }],
    data: (attrs) => ({ renditionsFor: marked(attrs), expected: signature }),
  }));
  // A marked file whose refusal was recorded under another budget: the rendition may be made now.
  if (budget !== undefined) {
    queries.push({
      where: [{ ref: TRANSCODE_REFUSED_ATTR, op: 'exists' }],
      data: (attrs) => {
        const kind = kindOf(attrs);
        const stale = Object.values(refusalsOf(attrs)).some((refusal) => refusal.budget !== budget);
        return kind && stale ? { renditionsFor: marked(attrs), expected: signatures.get(kind)! } : undefined;
      },
    });
  }

  const { examined, announced, limited } = await scanStale(cmd, {
    source: 'renditions-scan',
    fact: RENDITION_FACTS.stale,
    families: ['renditions'],
    root,
    limit,
    dry,
    verbose,
  }, queries);

  const unsure = unchecked.length > 0 ? ` (${unchecked.join(', ')} not checked: EMS did not say its CPU budget)` : '';
  return await answer(
    { examined, announced: announced.length, waiting: false, limited, unchecked, ...(verbose ? { paths: announced } : {}) },
    `${announced.length} of ${examined} file(s) announced${dry ? ' (dry run)' : ''}${limited ? `, stopped at --limit ${limit}` : ''}${unsure}`,
  );
};

renditionsScan.spec = {
  name: 'renditions-scan',
  effect: 'write' as const,
  description:
    'Announce every file whose renditions are not those the rendition table names now: its marker is missing or names another table, or a rendition was refused under a CPU budget EMS no longer runs',
  args: [
    { name: 'path', type: 'path' as const, optional: true, description: 'The tree to look in (default /)' },
  ],
  flags: [
    { name: 'limit', type: 'number' as const, description: `Facts one run announces at most (default ${DEFAULT_LIMIT}; 0 for no cap)` },
    { name: 'if-idle', type: 'bool' as const, description: 'Announce nothing while the rendition pipelines have work waiting' },
    { name: 'n', dryRun: true, type: 'bool' as const, description: 'Dry run — count what would be announced without announcing it' },
    { name: 'v', type: 'bool' as const, description: 'Name each file announced' },
  ],
  examples: ['renditions-scan -n', 'renditions-scan /archive/recipes', 'renditions-scan --if-idle --limit 0'],
  returns: 'how many files it looked at and how many it announced as media.renditions.stale.',
};

export default renditionsScan;
