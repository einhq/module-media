#!ts
import { basename, resolve } from '@std/path';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, type Node, parseArgs, readRenditionTable, reportUnknownFlags, shq, STEP_EXIT_TEMPORARY, verifyAccess } from '@ein/client';
import { imageFileName, imageRolesOf } from '@ein/api';
import { copyTags, deblur, denoise, findDefects, inpaint, type PictureEdit, renditions, type RestoreCallOptions, stepExitCode, unfade } from '@ems/client';
import type { FileRestoreAnswer, FileRestoreQueueAnswer, Restoration, RestorationStep, RestoreRequest } from '@media/api';
import { RESTORABLE } from '@media/damage';
import { generateImageLadder } from '@media/image-ladder';
import { normalizeAngle, normalizeMirror, pictureDims } from '@media/orientation';
import { removeNode, sweepStaleTemps, syncNonEmpty } from '@media/staged-output';

/**
 * Restore a photo: a copy of it with faded colours brought back (`--unfade`, EMS `image.unfade`),
 * dust and scratches found and filled (`--dust`, `image.defects` then `image.inpaint`), blur taken
 * out (`--blur focus` for a picture out of focus, `--blur motion` for a shaken camera,
 * `image.deblur`) and grain lessened (`--grain`, `image.denoise`), in that order, each step reading what the one before
 * wrote. The copy is a version of the file, `<file>/versions/restored-<n>.png` (`.tif` for a TIFF,
 * at its depth), frozen on the disk tier, with renditions of its own and a `restoration` attr
 * naming the steps and the models that answered. The file itself is never written.
 *
 * With `--dust` the defect finder's mask is kept beside the copy, `mask.png` at full size, and
 * `marks.png` in the picture's display frame for a page to lay over the original: the finder
 * guesses, and marks some of a picture's own details as damage. `--mask` fills a mask given instead
 * of finding one — the finder's corrected by hand, or a blemish painted on any photo — and keeps it
 * beside the copy the same way: a one-channel PNG of the picture as stored, nonzero where marked.
 *
 * The copy carries the file's metadata (`image.copy_tags`): its date, camera, place and colour
 * profile, an XMP history naming the steps, and an IPTC digital source type saying how it was made:
 * by a trained model painting it (`--fill lama`) or enhanced by algorithm.
 *
 * EMS reads the picture as stored, so the version is too: it takes the file's turn (`angle`,
 * `mirror`) to be shown upright, and carries it as its EXIF orientation. A person waits for it, so
 * the steps go ahead of batch work.
 *
 * `--queue` restores any number of pictures in the media pool instead, nobody waiting: it keeps the
 * steps on each picture the caller may edit as `restoreRequest`, whose write starts `media-restore`,
 * which runs `--requested` on it: the steps kept, behind interactive work, and the request cleared
 * once the version is written. A request that fails for another reason than EMS's moment keeps
 * `failed`, the reason, and is not run again until it is asked for anew.
 */

const TEMP_PREFIX = '.tmprestore-';
const MARKS_EDGE = 1600;

/** The bytes of the file at `from` written into the one at `to`. */
const copyContent = async (cmd: Command, from: string, to: string): Promise<void> => {
  const source = await cmd.sys.vfs.open(cmd.access, from, { mode: 'r' });
  try {
    const target = await cmd.sys.vfs.open(cmd.access, to, { mode: 'w' });
    try {
      for await (const chunk of source.readable) await target.write(chunk);
    } finally {
      await target.close();
    }
  } finally {
    await source.close();
  }
  await syncNonEmpty(cmd, to, 'copying the mask');
};

/** The first `restored-<n>.<ext>` not taken in `dir`. */
const nextName = async (cmd: Command, dir: string, ext: string): Promise<string> => {
  const taken = new Set((await cmd.sys.vfs.children(cmd.access, dir)).map((child) => child.name));
  for (let n = 1;; n++) {
    const name = `restored-${n}.${ext}`;
    if (!taken.has(name)) return name;
  }
};

/** The steps a restoration runs, from the flags or from a queued request. */
type Steps = { unfade: boolean; dust: boolean; dark: boolean; fill: 'ns' | 'telea' | 'lama'; blur?: 'focus' | 'motion'; grain?: number; mask?: string };

/** The steps asked for, or why they cannot run. */
const stepsOf = (asked: { unfade?: unknown; dust?: unknown; dark?: unknown; fill?: unknown; blur?: unknown; grain?: unknown; mask?: string }): Steps | string => {
  const fill = asked.fill ?? 'ns';
  if (fill !== 'ns' && fill !== 'telea' && fill !== 'lama') return `--fill is ns, telea or lama, not ${fill}`;
  if (asked.mask && asked.dust) return '--dust finds the marks and --mask gives them: name one';
  if (asked.dark && !asked.dust) return '--dark goes with --dust';
  if (asked.fill !== undefined && !asked.dust && !asked.mask) return '--fill goes with --dust or --mask';
  const grain = asked.grain === undefined ? undefined : Number(asked.grain);
  if (grain !== undefined && !(grain > 0 && grain <= 1)) return `--grain is a strength above 0 and at most 1, not ${asked.grain}`;
  const blur = asked.blur === undefined ? undefined : asked.blur;
  if (blur !== undefined && blur !== 'focus' && blur !== 'motion') return `--blur is focus or motion, not ${blur}`;
  if (!asked.unfade && !asked.dust && !asked.mask && blur === undefined && grain === undefined) return 'nothing to do: name --unfade, --dust, --mask, --blur or --grain';
  return {
    unfade: Boolean(asked.unfade),
    dust: Boolean(asked.dust),
    dark: Boolean(asked.dark),
    fill,
    ...(blur !== undefined ? { blur } : {}),
    ...(grain !== undefined ? { grain } : {}),
    ...(asked.mask ? { mask: asked.mask } : {}),
  };
};

/** The picture at `path`, or why the caller cannot restore it. */
const restorable = async (cmd: Command, path: string): Promise<Node | string> => {
  const node = await cmd.sys.vfs.get(cmd.access, path).catch(() => undefined);
  if (!node) return `${path}: file not found or unreadable`;
  if (node.type !== 'file') return `${path}: not a file node (is ${node.type})`;
  if (node.attrs.sourceId) return `${path}: a rendition or version; restore the file it belongs to`;
  const mimetype = typeof node.attrs.mimetype === 'string' ? node.attrs.mimetype : '';
  if (!RESTORABLE.has(mimetype)) return `${path}: ${mimetype || 'no mimetype'} cannot be restored; only JPEG, PNG, TIFF, WebP and BMP pictures`;
  // Asked before EMS is, so a refused write never spends its work (ein/core#535).
  if (!verifyAccess(cmd.access, node.props, 'w')) return `${path}: permission denied`;
  return node;
};

/** The steps run over the picture `node` at `inputPath` into a new version beside it; what was written. */
const restoreFile = async (cmd: Command, inputPath: string, node: Node, steps: Steps, call: RestoreCallOptions, verbose: boolean): Promise<FileRestoreAnswer> => {
  const { fill, blur, grain, mask: given } = steps;
  const format = node.attrs.mimetype === 'image/tiff' ? 'tiff' : 'png';
  const ext = format === 'tiff' ? 'tif' : 'png';
  const angle = normalizeAngle(node.attrs.angle);
  const mirror = normalizeMirror(node.attrs.mirror);

  await cmd.sys.vfs.ensure(cmd.access, 'directory', inputPath, 'versions', { props: { mode: 0o770 } });
  const dir = `${inputPath}/versions`;
  await sweepStaleTemps(cmd, dir, TEMP_PREFIX);

  // Every output a step writes, as a hidden temp in `versions/`; the last picture and the mask are
  // kept, on the disk tier, and the rest go when the run ends.
  const temps: string[] = [];
  const stage = async (what: string, kept: boolean): Promise<string> => {
    const name = `${TEMP_PREFIX}${crypto.randomUUID()}-${what}`;
    await cmd.sys.vfs.create(cmd.access, 'file', dir, name, kept ? { props: { tier: 'disk' } } : { attrs: { sourceId: node.id } });
    temps.push(`${dir}/${name}`);
    return `${dir}/${name}`;
  };

  const plan = [steps.unfade && 'unfade', (steps.dust || given) && 'dust', blur !== undefined && 'blur', grain !== undefined && 'grain'].filter((step): step is string =>
    Boolean(step)
  );
  const done: RestorationStep[] = [];
  let source = inputPath;
  let mask: string | undefined;
  let marked: number | undefined;
  try {
    for (const step of plan) {
      const output = await stage(`${step}.${ext}`, false);
      if (step === 'unfade') {
        const made = await unfade(cmd, source, { output, format }, call);
        done.push({ op: 'image.unfade', params: { levels: made.levels, gammas: made.gammas }, producer: made.producer });
      } else if (step === 'dust') {
        mask = await stage('mask.png', true);
        if (given) {
          await copyContent(cmd, given, mask);
        } else {
          const dark = Boolean(steps.dark);
          const found = await findDefects(cmd, source, { output: mask, dark }, call);
          await syncNonEmpty(cmd, mask, 'image.defects');
          marked = found.fraction;
          done.push({ op: 'image.defects', params: { dark }, producer: found.producer });
        }
        const made = await inpaint(cmd, source, { mask, output, format, method: fill }, call);
        if (given) marked = made.width * made.height > 0 ? made.filled / (made.width * made.height) : 0;
        done.push({ op: 'image.inpaint', params: { method: fill, ...(given ? { given: true } : {}) }, producer: made.producer });
      } else if (step === 'blur') {
        const made = await deblur(cmd, source, { output, format, blur: blur! }, call);
        done.push({ op: 'image.deblur', params: { blur }, producer: made.producer });
      } else {
        const made = await denoise(cmd, source, { output, format, strength: grain }, call);
        done.push({ op: 'image.denoise', params: { strength: grain }, producer: made.producer });
      }
      await syncNonEmpty(cmd, output, done[done.length - 1].op);
      if (verbose) await cmd.writeLn(`${done[done.length - 1].op} done`);
      source = output;
    }

    const at = new Date().toISOString();
    const tagged = await stage(`tags.${ext}`, true);
    const history: PictureEdit[] = done.map((step) => ({
      action: 'edited',
      when: at,
      softwareAgent: step.producer,
      parameters: `${step.op} ${JSON.stringify(step.params)}`,
      changed: '/',
    }));
    const generative = done.some((step) => step.op === 'image.inpaint' && step.params.method === 'lama');
    await copyTags(cmd, source, {
      source: inputPath,
      output: tagged,
      angle,
      mirror,
      history,
      digitalSourceType: generative ? 'compositeWithTrainedAlgorithmicMedia' : 'algorithmicallyEnhanced',
    }, call);
    await syncNonEmpty(cmd, tagged, 'image.copy_tags');
    source = tagged;

    const name = await nextName(cmd, dir, ext);
    const path = `${dir}/${name}`;
    await cmd.sys.vfs.rename(cmd.access, dir, basename(source), dir, name, { failIfExists: true });
    temps.splice(temps.indexOf(source), 1);
    const restoration: Restoration = { steps: done, at, ...(marked !== undefined ? { marked } : {}) };
    const { width, height } = node.attrs;
    await cmd.sys.vfs.update(cmd.access, path, {
      attrs: { sourceId: node.id, frozen: true, restoration, angle, mirror, ...(width ? { width } : {}), ...(height ? { height } : {}) },
    });
    const version = await cmd.sys.vfs.get(cmd.access, path);

    const answer: FileRestoreAnswer = { path, name, restoration };
    if (mask) {
      await cmd.sys.vfs.rename(cmd.access, dir, basename(mask), path, 'mask.png', { failIfExists: true });
      temps.splice(temps.indexOf(mask), 1);
      answer.mask = `${path}/mask.png`;
      await cmd.sys.vfs.update(cmd.access, answer.mask, { attrs: { sourceId: version.id, frozen: true } });
      // The marks in the display frame, as the page lays them over the original.
      answer.marks = `${path}/marks.png`;
      await cmd.sys.vfs.create(cmd.access, 'file', path, 'marks.png', { attrs: { sourceId: version.id } });
      await renditions(cmd, answer.mask, {
        mimetype: 'image/png',
        angle,
        mirror,
        targets: [{ output: answer.marks, format: 'png', box: { width: MARKS_EDGE, height: MARKS_EDGE }, fit: 'contain' }],
      });
      await syncNonEmpty(cmd, answer.marks, 'marks');
    }

    // The version's own renditions, so a page shows it as it shows the file.
    const { table } = await readRenditionTable(cmd.sys.vfs);
    const picture = Number(width) > 0 && Number(height) > 0 ? pictureDims(Number(width), Number(height), angle, undefined) : undefined;
    await cmd.execute(`mkdir -p --under ${shq(path)} ${shq(`${path}/thumbnails`)}`);
    await generateImageLadder(
      cmd,
      { path, id: version.id, mimetype: String(version.attrs.mimetype ?? `image/${format}`), angle, mirror },
      imageRolesOf(table, 'photo', picture).map((role) => {
        const rendition = table.image[role];
        return {
          outputPath: `${path}/thumbnails/${imageFileName(rendition)}`,
          width: rendition.width,
          height: rendition.height,
          fit: rendition.fit,
          quality: rendition.quality,
        };
      }),
    );

    return answer;
  } finally {
    for (const temp of temps) await removeNode(cmd, temp, dir);
  }
};

/** Each picture's steps kept as its `restoreRequest`, for `media-restore` to run. */
const queue = async (cmd: Command, paths: string[], steps: Steps): Promise<FileRestoreQueueAnswer> => {
  const { mask: _, blur, grain, ...rest } = steps;
  const request: RestoreRequest = { ...rest, ...(blur !== undefined ? { blur } : {}), ...(grain !== undefined ? { grain } : {}), at: new Date().toISOString() };
  const answer: FileRestoreQueueAnswer = { queued: [], refused: [] };
  for (const path of paths) {
    const node = await restorable(cmd, path);
    if (typeof node === 'string') {
      answer.refused.push({ path, reason: node });
      continue;
    }
    try {
      await cmd.sys.vfs.update(cmd.access, path, { attrs: { restoreRequest: request } });
      answer.queued.push(path);
    } catch (error) {
      answer.refused.push({ path, reason: `${path}: ${error instanceof Error ? error.message : String(error)}` });
    }
  }
  return answer;
};

const fileRestore = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    boolean: ['unfade', 'dust', 'dark', 'verbose', 'queue', 'requested'],
    string: ['fill', 'blur', 'grain', 'mask'],
    alias: { v: 'verbose' },
    unknown: collectUnknownFlags(unknown),
  });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const fail = async (message: string): Promise<number> => {
    await cmd.writeError(`file-restore: ${message}\n`);
    return 1;
  };
  const verbose = Boolean(flags.verbose);
  const paths = flags._.map((arg) => resolve(cmd.cwd, String(arg)));
  if (paths.length === 0) return await fail('missing file path');
  if (flags.queue && flags.requested) return await fail('--queue asks and --requested runs what was asked: name one');

  if (flags.requested) {
    if (paths.length > 1) return await fail('--requested runs one picture');
    const node = await restorable(cmd, paths[0]);
    if (typeof node === 'string') return await fail(node);
    const request = node.attrs.restoreRequest as RestoreRequest | null | undefined;
    if (!request || typeof request !== 'object' || request.failed) {
      if (verbose) await cmd.writeLn(`${paths[0]}: no restoration asked for`);
      return 0;
    }
    const steps = stepsOf(request);
    try {
      if (typeof steps === 'string') throw new Error(steps);
      const answer = await restoreFile(cmd, paths[0], node, steps, verbose ? { onProgress: async (phase) => await cmd.writeLn(`  ${phase}`) } : {}, verbose);
      // Only the request this run answered: one asked anew meanwhile is left for its own run.
      const now = (await cmd.sys.vfs.get(cmd.access, paths[0])).attrs.restoreRequest as RestoreRequest | null | undefined;
      if (now?.at === request.at) await cmd.sys.vfs.update(cmd.access, paths[0], { attrs: { restoreRequest: null } });
      if (cmd.json) await cmd.writeJSON(answer);
      else await cmd.writeLn(`${answer.path}: ${answer.restoration.steps.map((step) => step.op).join(', ')}`);
      return 0;
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      const code = stepExitCode(error);
      if (code !== STEP_EXIT_TEMPORARY) await cmd.sys.vfs.update(cmd.access, paths[0], { attrs: { restoreRequest: { ...request, failed: message } } });
      await fail(`${paths[0]}: ${message}`);
      return code;
    }
  }

  const given = flags.mask ? resolve(cmd.cwd, flags.mask) : undefined;
  if (flags.queue && given) return await fail('--mask fills one picture, and --queue restores them as a set: restore it alone');
  const steps = stepsOf({ unfade: flags.unfade, dust: flags.dust, dark: flags.dark, fill: flags.fill, blur: flags.blur, grain: flags.grain, mask: given });
  if (typeof steps === 'string') return await fail(steps);

  if (flags.queue) {
    const answer = await queue(cmd, paths, steps);
    if (cmd.json) await cmd.writeJSON(answer);
    else {
      for (const { reason } of answer.refused) await cmd.writeError(`file-restore: ${reason}\n`);
      await cmd.writeLn(`${answer.queued.length} queued to restore`);
    }
    // A page reads the refusals from the answer; a shell is told by the exit too.
    return answer.queued.length > 0 || cmd.json ? 0 : 1;
  }

  if (paths.length > 1) return await fail('one picture at a time, or --queue for several');
  const node = await restorable(cmd, paths[0]);
  if (typeof node === 'string') return await fail(node);
  if (given) {
    const mask = await cmd.sys.vfs.get(cmd.access, given).catch(() => undefined);
    if (!mask || mask.type !== 'file') return await fail(`${given}: no mask file there`);
    if (!(Number(mask.attrs.size) > 0)) return await fail(`${given}: an empty file, not a mask`);
  }
  try {
    const call: RestoreCallOptions = { interactive: true, ...(verbose ? { onProgress: async (phase: string) => await cmd.writeLn(`  ${phase}`) } : {}) };
    const answer = await restoreFile(cmd, paths[0], node, steps, call, verbose);
    if (cmd.json) await cmd.writeJSON(answer);
    else await cmd.writeLn(`${answer.path}: ${answer.restoration.steps.map((step) => step.op).join(', ')}`);
    return 0;
  } catch (error) {
    return await fail(`${paths[0]}: ${error instanceof Error ? error.message : String(error)}`);
  }
};

fileRestore.spec = {
  name: 'file-restore',
  effect: 'write' as const,
  description: 'Restore a photo into a new version beside it: faded colours back, dust and scratches filled, blur taken out, grain lessened',
  args: [{ name: 'file', type: 'path' as const, description: 'The picture to restore (JPEG, PNG, TIFF, WebP or BMP), or with --queue any number; it is never written' }],
  flags: [
    { name: 'unfade', type: 'bool' as const, description: 'Give a faded colour print its colours back: each channel stretched, the neutral tones made grey' },
    { name: 'dust', type: 'bool' as const, description: 'Find dust, scratches and cracks and fill them from what surrounds them' },
    { name: 'dark', type: 'bool' as const, description: 'With --dust, look for damage darker than the picture too' },
    {
      name: 'fill',
      type: 'string' as const,
      description: 'With --dust or --mask, how the damage is filled: ns (the default) or telea for dust and thin scratches, lama for creases and tears',
    },
    {
      name: 'mask',
      type: 'path' as const,
      description:
        'Fill what this mask marks instead of finding the damage: a one-channel PNG the size of the picture as stored, nonzero where marked. It is copied beside the version',
    },
    { name: 'blur', type: 'string' as const, description: 'Take out blur: focus for a picture out of focus, motion for one blurred by a moving camera' },
    { name: 'grain', type: 'string' as const, description: 'Lessen grain and noise, at this strength (above 0, at most 1; 0.5 keeps about half the grain)' },
    {
      name: 'queue',
      type: 'bool' as const,
      description: 'Restore the pictures named in the media pool, nobody waiting: each gets its steps as restoreRequest, and a version when its turn comes',
    },
    { name: 'requested', type: 'bool' as const, description: "Run the steps a picture's restoreRequest asks for, and clear it (what the media pool runs)" },
    { name: 'v', type: 'bool' as const, description: 'Say each step as it runs' },
  ],
  examples: [
    'file-restore /archive/scans/1974/print-07.jpg --unfade --dust',
    'file-restore /archive/scans/1952/portrait.tif --dust --dark --fill lama --grain 0.5',
    'file-restore /archive/scans/1974/print-07.jpg --unfade --mask /archive/scans/1974/print-07-mask.png',
    'file-restore /archive/scans/1968/party.jpg --blur motion',
    'file-restore --queue --unfade --dust /archive/scans/1974/*.jpg',
  ],
  returns: 'The version written, with the steps that made it and, with --dust or --mask, its mask and marks; with --queue the pictures queued and those refused, and why',
};

export default fileRestore;
